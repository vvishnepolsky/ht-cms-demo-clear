# State-X Medicaid Application (resident app) — environment variables
# Copy to .env.local for local development. Vite bakes VITE_* vars into the
# bundle at build time — they are NOT runtime secrets.
#
# The app talks only to the same origin: `/api/*` (identity + Verify Assist
# REST) and `/graphql`. In dev, vite.config.ts proxies both to the demo server
# on http://localhost:4000 (override with VITE_DEV_API_TARGET). In prod the
# server serves this bundle, so nothing needs to be set.

# State-X tenant customer ID. Sent as x-customer-id on every request (the demo
# server accepts and ignores it). Not a secret.
VITE_CUSTOMER_ID=00000000-0000-4000-a000-000000000003

# Optional overrides — leave unset for same-origin defaults.
# VITE_GATEWAY_URL=/graphql          # GraphQL endpoint (default: /graphql)
# VITE_IDENTITY_URL=                 # Base URL for /api/* REST (default: '' = same origin)
# VITE_DEV_API_TARGET=http://localhost:4000   # dev-proxy target for /api and /graphql

# Mapbox Address Autofill token — leave empty to disable autocomplete (manual entry only)
VITE_MAPBOX_ACCESS_TOKEN=
