# State-X E&E demo server — copy to .env for local overrides. Real env vars win.

# HTTP port. Every SPA proxies /api and /graphql here in dev.
PORT=4000

# `production` turns on static SPA serving and Secure cookies. SERVE_STATIC=true
# forces static serving in non-prod (requires the apps to be built).
NODE_ENV=
SERVE_STATIC=false

# SQLite file, relative to apps/server/. Created on first boot. Render: /var/data/demo.db
DATABASE_PATH=./data/demo.db

# Base URL of this deploy (Render sets RENDER_EXTERNAL_URL). Empty in local dev.
PUBLIC_URL=

# Where the resident portal and the hosted Verify Assist flow run. Defaults:
# PUBLIC_URL (or http://localhost:5181) and PUBLIC_URL/verify (or http://localhost:5187).
RESIDENT_APP_URL=
VERIFY_APP_URL=
# Path (under RESIDENT_APP_URL) the hosted flow returns to; `?verified=<id>` is appended.
VERIFY_ASSIST_RETURN_PATH=/#/personal

# true (default): local mock of the CLEAR hosted flow (deterministic demo identities).
# false: real CLEAR sandbox via the Standard Integration — needs both keys below,
# otherwise the server logs a warning and stays in mock mode.
MOCK_CLEAR=true
CLEAR_API_KEY=
CLEAR_PROJECT_ID=

# Opt-in: overlay the demo identities (Jordan Rivera + SC Medicaid) on real sandbox runs.
DEMO_ENRICHMENT=false

# Tenant jurisdiction for the out-of-state Medicaid rule (SCMCD→SC, ILMCD→IL are out of state).
VERIFY_ASSIST_TENANT_STATE=SX

# Case Assist narrative. Unset = deterministic template. Set = one Claude call per
# case (cached; regenerated when the recommendation set changes).
ANTHROPIC_API_KEY=
CASE_ASSIST_MODEL=claude-opus-5

# Reserved (sessions are opaque tokens; no signing needed today).
SESSION_SECRET=
