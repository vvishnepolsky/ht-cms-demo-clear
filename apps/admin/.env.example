# CMS E&E Demo — Admin App — Environment Variables
# Copy to .env.local for local development. Vite bakes VITE_* vars into the
# bundle at build time — they are NOT runtime secrets.
#
# The app talks to apps/server on the SAME ORIGIN (/graphql, /api/auth/*).
# In dev, vite.config.ts proxies those paths to http://localhost:4000, so no
# URL needs to be configured. Override only if the server runs elsewhere.
# VITE_GATEWAY_URL=/graphql
# VITE_IDENTITY_URL=

# Demo credentials pre-filled on the login form (dev only — read when
# import.meta.env.DEV is true). Seeded staff logins:
#   admin@state-x.gov / password1234       (admin, "David Chen")
#   caseworker@state-x.gov / password1234  (caseworker, "Maria Lopez")
VITE_DEMO_EMAIL=caseworker@state-x.gov
VITE_DEMO_PASSWORD=password1234
