{
  "name": "@ht/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Language translation and i18n for member-facing apps \u2014 Section 1557 / LEP support",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./locales/*": "./locales/*"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "i18next": "^23.16.8",
    "react-i18next": "^15.7.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
